{
  "name": "@deepseek-ai/dsh-desktop-app",
  "description": "Electron desktop profile layer with Tencent CodeBuddy as the key-only default provider",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/desktop-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-browser": "workspace:^",
    "@deepseek-ai/dsh-browser-popup": "workspace:^",
    "@deepseek-ai/dsh-client-ui-brand-desktop": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-mcp": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-skill": "workspace:^",
    "@deepseek-ai/dsh-llm-tencent-codebuddy": "workspace:^",
    "@deepseek-ai/dsh-mcp-manager": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  }
}
