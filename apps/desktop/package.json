  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop application for DeepSeek Harness with Tencent CodeBuddy onboarding",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "files": [
    "lib/main.js"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown",
    "start": "electron .",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "package:mac": "electron-builder --mac",
    "package:mac:arm64": "electron-builder --mac dmg --arm64",
    "package:mac:x64": "electron-builder --mac dmg --x64"
  },
  "dependencies": {
