  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@koromix/koffi-darwin-arm64": "3.1.1",
    "@koromix/koffi-darwin-x64": "3.1.1",
    "@koromix/koffi-win32-x64": "3.1.1",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "node-addon-require-builtin-darwin-arm64": "0.1.4",
    "node-addon-require-builtin-darwin-x64": "0.1.4",
    "node-addon-require-builtin-win32-x64-msvc": "0.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.deepseek.harness",
    "productName": "DeepSeek Harness",
    "icon": "../web/public/favicon.svg",
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "node_modules/**/*.node",
      "node_modules/**/*.dylib",
      "node_modules/**/*.so",
      "node_modules/**/*.so.*",
      "node_modules/**/*.dll",
      "node_modules/**/*.exe",
      "**/koffi/**",
      "**/@koromix/koffi-*/**",
      "node_modules/node-pty/**/spawn-helper",
      "**/dsh-host-directory-picker-native/lib/**",
      "node_modules/@vscode/ripgrep-*/bin/**",
      "node_modules/@deepseek-ai/node-addon-landlock-run-*/bin/**"
    ],
    "files": [
      "lib/**",
      "package.json",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/*.map",
      "!**/*.d.ts",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/HISTORY*",
      "!node_modules/*/{test,tests,__tests__,docs,doc,example,examples}/**",
      "!node_modules/@*/*/{test,tests,__tests__,docs,doc,example,examples}/**"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "removePackageScripts": true,
    "publish": null,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "files": [
        "lib/**",
        "package.json",
        "!**/*.ts",
        "!**/*.tsx",
        "!**/*.map",
        "!**/*.d.ts",
        "!node_modules/**/README*",
        "!node_modules/**/CHANGELOG*",
        "!node_modules/**/HISTORY*",
        "!node_modules/*/{test,tests,__tests__,docs,doc,example,examples}/**",
        "!node_modules/@*/*/{test,tests,__tests__,docs,doc,example,examples}/**",
        "!node_modules/@img/sharp-!(darwin-${arch}|libvips-*)/**",
        "!node_modules/@img/sharp-libvips-!(darwin-${arch})/**",
        "!node_modules/@koromix/koffi-!(darwin-${arch})/**",
        "!node_modules/@vscode/ripgrep-!(darwin-${arch})/**",
        "!node_modules/@deepseek-ai/node-addon-landlock-run-*/**",
        "!node_modules/node-addon-require-builtin-!(darwin-${arch})/**",
        "!node_modules/node-pty/build/**",
        "!node_modules/node-pty/prebuilds/!(darwin-${arch})/**"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "sign": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
